{
  "name": "dag-pi",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start": "pnpm --filter @dag-pi/api start",
    "preview": "pnpm build && pnpm start",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,vue,js,mjs,cjs}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.8",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.3.0"
  }
}
