{
  "name": "@kaijia/workflows",
  "version": "0.2.1",
  "description": "workflows Web Agent 工作台 CLI(wfs 命令):tsc 编译 + npm 发布的自包含 npm 包",
  "type": "module",
  "bin": {
    "wfs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/prepare.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "node scripts/prepare.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@ff-labs/fff-node": "0.10.1",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.34",
    "picomatch": "^4.0.5",
    "typebox": "1.3.7",
    "unbash": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@workflows/shared": "workspace:*",
    "typescript": "^6.0.3"
  }
}
